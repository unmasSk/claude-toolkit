#!/usr/bin/env python3
"""gitmem -- facade of the memory system.

Lives INSIDE unmassk-toolkit/, not in a separate plugin. Prints what the
subcommand script returns; with --version, the toolkit version.

Nine subcommands (see SUBCOMMANDS). Each one reaches its real script
(`bin/memory/<subcommand>.py`) BY PATH, never imported, so this facade
cannot reimplement anything and the two paths cannot diverge: a rejection
from `gitmem note` must be byte-for-byte identical to `note.py` run
directly (tests/memory/test_gitmem_facade.py, `TestAddsNoLogicOfItsOwn`).
Dispatch is a `subprocess.run` with inherited streams (never captured or
reprinted here), so stdout/stderr/returncode arrive intact.

An unknown subcommand fails (non-zero return code) and names the nine
that really exist.
"""

import json
import os
import subprocess
import sys

_BIN_DIR = os.path.dirname(os.path.abspath(__file__))
_ROOT_DIR = os.path.dirname(_BIN_DIR)
_BIN_MEMORY_DIR = os.path.join(_BIN_DIR, "memory")
# The memory system modules live in lib/memory/, not directly in lib/,
# so they do not clash with the toolkit's surviving lib/colors.py.
_LIB_DIR = os.path.join(_ROOT_DIR, "lib", "memory")
if _LIB_DIR not in sys.path:
    sys.path.insert(0, _LIB_DIR)

from utf8 import force_utf8_streams  # noqa: E402

force_utf8_streams()

# Real subcommands -- one per script in bin/memory/. The subcommand name
# IS the file name without ".py": a single table, never two lists that can
# drift apart.
SUBCOMMANDS = (
    "note",
    "work",
    "wip",
    "remove",
    "next",
    "search",
    "zones",
    "rezones",
    "rule",
)

# One line per subcommand, next to SUBCOMMANDS. The check below fails loudly
# on import if a subcommand has no description (or one is left over).
DESCRIPTIONS = {
    "note": "Save a memory note (D/M/R/Q/X/I/B) as its own commit",
    "work": "Commit code changes for the given paths only",
    "wip": "Quick unreviewed checkpoint commit of work in progress",
    "remove": "Retire a note from the live index (archives it)",
    "next": "Write the session-close Next (empty commit) for the next session",
    "search": "Search memory by zone, word, ID or file",
    "zones": "List, find or add the project's zones",
    "rezones": "Check (--verify) or rebuild the zone and note indexes from git",
    "rule": "Add, read, retract or replace the project's working rules",
}

if set(DESCRIPTIONS) != set(SUBCOMMANDS):
    raise SystemExit(
        "gitmem: DESCRIPTIONS and SUBCOMMANDS differ: "
        f"{sorted(set(DESCRIPTIONS) ^ set(SUBCOMMANDS))}"
    )


def _read_version() -> str:
    """Read the version from the toolkit manifest (single source of truth)."""
    manifest_path = os.path.join(_ROOT_DIR, ".claude-plugin", "plugin.json")
    with open(manifest_path, "r", encoding="utf-8") as fh:
        return json.load(fh)["version"]


def _print_usage():
    print(f"gitmem {_read_version()}")
    print("Usage: gitmem <command> [args]    (gitmem <command> --help for details)")
    print("Commands:")
    for name in SUBCOMMANDS:
        print(f"  {name:<8} {DESCRIPTIONS[name]}")


def _print_unknown_subcommand(subcommand):
    print(f"gitmem: unknown subcommand: {subcommand!r}", file=sys.stderr)
    print("Available subcommands:", file=sys.stderr)
    for name in SUBCOMMANDS:
        print(f"  gitmem {name}", file=sys.stderr)


def _dispatch(subcommand, rest_argv):
    """Run `bin/memory/<subcommand>.py` as a separate process with the same
    arguments, same interpreter and inherited streams, so its output is
    indistinguishable from running it directly. The child's returncode is
    propagated as is.
    """
    script_path = os.path.join(_BIN_MEMORY_DIR, f"{subcommand}.py")
    result = subprocess.run([sys.executable, script_path, *rest_argv])
    return result.returncode


def main(argv):
    if not argv or argv[0] in ("--help", "-h", "help"):
        _print_usage()
        return 0

    if argv[0] == "--version":
        print(f"gitmem {_read_version()}")
        return 0

    subcommand, rest_argv = argv[0], argv[1:]
    if subcommand not in SUBCOMMANDS:
        _print_unknown_subcommand(subcommand)
        return 1

    return _dispatch(subcommand, rest_argv)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception as exc:  # never a stack trace
        print(f"gitmem: {exc}", file=sys.stderr)
        sys.exit(1)
