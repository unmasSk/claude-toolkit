# macOS
.DS_Store
**/.DS_Store

# Python
*.pyc
__pycache__/
.venv/
.mypy_cache/
.pytest_cache/

# Editor/tool backups (e.g. sed -i .bak, never track)
*.bak
*.bak[0-9]
*.back
*.back[0-9]
*~

# Generated
.claude/.message-counter
.claude/.session-booted
.claude/git-memory-manifest.json
.claude/.glossary-cache.json
.claude/.context-status.json
.claude/.context-warn-state.json
.ref-repos/*
!.ref-repos/SOURCES.md

# unmassk-toolkit generated (do not track)
.claude/.unmassk/
.claude/worktrees/

# unmassk-toolkit generated (do not track)
.claude/.unmassk/context-warn-state.json

# Candados del sistema de memoria: los crea un proceso un instante y sobran.
# NO usar un `*.lock` a secas: Cargo.lock y bun.lock de chatroom son dependencias
# legitimas y tienen que seguir versionadas.
.claude/project-memory/*.lock

# unmassk-trading: los scripts levantados escriben informes y journal con ruta
# relativa al directorio actual, asi que el riesgo real es la raiz del repositorio
/reports/
/state/
unmassk-trading/skills/unmassk-trading/reports/
unmassk-trading/skills/unmassk-trading/state/
