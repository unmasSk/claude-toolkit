# DataForSEO — SERP, keywords, backlinks, on-page and domain analytics
# Credentials: https://app.dataforseo.com/api-dashboard
DATAFORSEO_USERNAME=your-dataforseo-email@example.com
DATAFORSEO_PASSWORD=your-dataforseo-password

# Ahrefs — backlink and keyword research
# API key: https://app.ahrefs.com/api/profile
AHREFS_API_KEY=your-ahrefs-api-key

# SEMrush — keyword and competitive research (SSE transport)
# API key: https://www.semrush.com/api-analytics/
SEMRUSH_API_KEY=your-semrush-api-key

# Google Search Console — impressions, clicks, position data for your properties
# Path to a service-account credentials JSON file with Search Console read access
# Docs: https://developers.google.com/webmaster-tools/v1/how-tos/authorizing
GSC_CREDENTIALS_PATH=/path/to/gsc-service-account-credentials.json

# Google PageSpeed Insights — Core Web Vitals and Lighthouse scores
# API key: https://console.cloud.google.com/ → PageSpeed Insights API
PAGESPEED_API_KEY=your-pagespeed-api-key
