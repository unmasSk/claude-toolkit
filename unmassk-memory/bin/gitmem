#!/usr/bin/env python3
"""gitmem -- fachada del sistema de memoria v2.

Fase 0: todavia no hay generador ni validador que despachar, asi que
este script solo imprime la version del plugin y la lista de
subcomandos previstos -- es la prueba de que el bucle de desarrollo
corre por ruta (``python3 unmassk-memory/bin/gitmem``), sin pasar por
la cache del plugin ni instalar nada. El despacho real a cada
subcomando llega junto con bin/note.py, bin/close.py, etc. (fase 2).
"""

import json
import os
import sys

_BIN_DIR = os.path.dirname(os.path.abspath(__file__))
_ROOT_DIR = os.path.dirname(_BIN_DIR)
_LIB_DIR = os.path.join(_ROOT_DIR, "lib")
if _LIB_DIR not in sys.path:
    sys.path.insert(0, _LIB_DIR)

from utf8 import force_utf8_streams  # noqa: E402

force_utf8_streams()

# Subcomandos previstos -- uno por script en bin/ (ARQUITECTURA.md SS1).
SUBCOMMANDS = (
    "note",
    "close",
    "context",
    "work",
    "search",
    "boot",
    "reindex",
    "zones",
    "rule",
    "bench",
)


def _read_version() -> str:
    """Lee la version desde el manifiesto -- una sola fuente de verdad,
    nunca un literal duplicado aqui."""
    manifest_path = os.path.join(_ROOT_DIR, ".claude-plugin", "plugin.json")
    with open(manifest_path, "r", encoding="utf-8") as fh:
        return json.load(fh)["version"]


def main() -> int:
    print(f"gitmem {_read_version()}")
    print("Subcomandos previstos (aun sin despacho real, fase 0):")
    for name in SUBCOMMANDS:
        print(f"  gitmem {name}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
